{
  "name": "privacy-lens-client-api",
  "version": "1.0.0",
  "description": "Client API process for PrivacyLens Chrome plugin",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "privacy",
    "client-api",
    "chrome-plugin"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@privacy-lens/shared": "file:../shared",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "stripe": "^14.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.8"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"]
  }
} 