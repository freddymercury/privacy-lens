# PrivacyLens Environment Configuration

# Node Environment
NODE_ENV=development

# Process Configuration
PROCESS_NAME=main

# Database Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DB_MAX_RETRIES=3
DB_RETRY_DELAY=1000

# Queue Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=1000

# Client API Configuration
CLIENT_API_PORT=3000
CLIENT_API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Plugin API Configuration
PLUGIN_API_PORT=3001
PLUGIN_API_HOST=0.0.0.0

# Admin Dashboard Configuration
ADMIN_DASHBOARD_PORT=3002
ADMIN_DASHBOARD_HOST=0.0.0.0
SESSION_SECRET=your-session-secret-key-change-this-in-production

# Archive API Configuration
ARCHIVE_API_PORT=3003
ARCHIVE_API_HOST=0.0.0.0

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Background Jobs Configuration
WORKER_CONCURRENCY=2
CLEANUP_INTERVAL=3600000
ARCHIVE_INTERVAL=86400000

# Authentication
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
API_KEY_EXPIRY=365d

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty # pretty or json

# Assessment Configuration
ASSESSMENT_TIMEOUT=300000
ASSESSMENT_MAX_RETRIES=3
ASSESSMENT_RETRY_DELAY=60000

# Archive Configuration
ARCHIVE_FREQUENCY=7 # days
ARCHIVE_RETENTION=365 # days
ARCHIVE_STORAGE_PATH=./archives

# LLM Configuration (if applicable)
LLM_API_KEY=your-llm-api-key
LLM_API_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0.7

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=yourpassword (if needed)
