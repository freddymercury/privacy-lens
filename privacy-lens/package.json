{
  "name": "privacy-lens",
  "version": "1.0.0",
  "description": "A privacy policy analysis and monitoring tool",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js start",
    "start:client-api": "node index.js start client-api",
    "start:plugin-api": "node index.js start plugin-api",
    "start:admin-dashboard": "node index.js start admin-dashboard",
    "start:archive-api": "node index.js start archive-api",
    "start:background-jobs": "node index.js start background-jobs",
    "stop": "node index.js stop",
    "restart": "node index.js restart",
    "status": "node index.js status",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "nodemon index.js start"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "privacy",
    "policy",
    "analysis",
    "monitoring",
    "gdpr",
    "ccpa"
  ],
  "author": "PrivacyLens Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "amqplib": "^0.10.3",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "extensionsToTreatAsEsm": [
      ".js"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
