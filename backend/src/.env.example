# Environment Variables for PrivacyLens Backend

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=privacylens
DB_USER=postgres
DB_PASSWORD=postgres

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_public_anon_key_here # Public Anon Key (Used for RLS clients)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here # Service Role Key (Bypasses RLS)

# LLM Configuration
OPENAI_API_KEY=sk_your_openai_api_key_here
LLM_MODEL=gpt-4 # Or specify another model like gpt-3.5-turbo

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_MONTHLY_PRICE_ID=price_monthly_id_here
STRIPE_ANNUAL_PRICE_ID=price_annual_id_here

# Email Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@privacylens.com

# API Configuration
API_URL=https://api.privacy-lens.example.com

# Search Configuration
SERPAPI_API_KEY=your_serpapi_api_key_here

# Archiver Service Configuration
S3_BUCKET=privacylens-archive # Name of the Supabase Storage bucket for policy archives
ARCHIVE_SCHEDULE="0 */6 * * *" # Cron schedule for the policy archiver job (e.g., every 6 hours)
